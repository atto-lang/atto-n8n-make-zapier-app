// Pure execution policy. Durable writes and effects belong to the worker adapter.
define module domain as
  pub fnc may_transition(string before, string after): bool {
    if before == "queued" then return after == "running" || after == "cancelled"; fi
    if before == "running" then
      return after == "waiting" || after == "succeeded" || after == "failed" || after == "cancelled";
    fi
    if before == "waiting" then return after == "queued" || after == "cancelled"; fi
    return false;
  }
  pub fnc retry_delay_ms(int attempt, int base_ms, int cap_ms): Result<int, string> {
    if attempt < 1 || attempt > 32 || base_ms < 1 || cap_ms < base_ms || cap_ms > 86400000 then
      return Err("invalid retry policy");
    fi
    let int delay = base_ms;
    for (let int i = 1; i < attempt; i = i + 1) {
      if delay > cap_ms / 2 then return Ok(cap_ms); fi
      delay = delay * 2;
    }
    return Ok(delay);
  }
  // Pure admission predicate for serializable durable effect commands.
  // Only a worker that has independently authenticated the lease, committed
  // the checkpoint, and proved absence in its transactional outbox may use
  // this decision. This is not itself an atomic DB write or replay executor.
  pub fnc may_publish_durable_effect(
    int run_generation, int lease_generation,
    int committed_sequence, int next_sequence,
    bool checkpoint_durable, bool cancelled, bool already_enqueued
  ): bool {
    if run_generation <= 0 || run_generation != lease_generation then return false; fi
    if committed_sequence < 0 || committed_sequence >= 9223372036854775807 then return false; fi
    if next_sequence <= 0 || next_sequence != committed_sequence + 1 then return false; fi
    if !checkpoint_durable || cancelled || already_enqueued then return false; fi
    return true;
  }
  pub fnc executable_kind(string kind): bool {
    return kind == "manual" || kind == "transform" || kind == "approval";
  }
end
