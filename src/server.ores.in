import module spin from '../dependencies/spin/src/spin';
import module routes from '../generated/routes';
import module http_routing from '../dependencies/http-routing/src/http_routing';
import module views from './views';
import module assets from '../generated/assets';

define isoactor Dashboard as
  receive(ActorMail<String> mail): void {
    val request = http.claim(mail.value);
    request.set_header("Cache-Control", "no-store");
    request.set_header("X-Ores-Contract", routes.contract_sha256());
    request.set_header("X-Content-Type-Options", "nosniff");
    request.set_header("Content-Security-Policy", "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'");
    val string page = views.page();
    val Future<void> response = spin.html(rt borrow request, 200, page);
    await response;
    self.end();
    return;
  }
end

define isoactor Preview as
  receive(ActorMail<String> mail): void {
    val request = http.claim(mail.value);
    request.set_header("Cache-Control", "no-store");
    val string body = views.preview("Preview reached approval; a real run would now wait for an authorized decision.");
    val Future<void> response = spin.html(rt borrow request, 200, body);
    await response;
    self.end();
    return;
  }
end

define isoactor Health as
  receive(ActorMail<String> mail): void {
    val request = http.claim(mail.value);
    val Future<void> response = spin.json(rt borrow request, 200, "{\"status\":\"development\",\"durable_execution\":false,\"websocket\":false}");
    await response;
    self.end();
    return;
  }
end

define isoactor WebsocketUnavailable as
  receive(ActorMail<String> mail): void {
    val request = http.claim(mail.value);
    val Future<void> response = spin.json(rt borrow request, 501, "{\"error\":\"session_websocket_transport_not_implemented\"}");
    await response;
    self.end();
    return;
  }
end

pub async routine main(): void {
  let mut builder = spin.builder();
  // @generated-route-registration
  val app = builder.build().unwrap();
  val server = http.listen("127.0.0.1", 8080, 64, 65536, 10000);
  stdio.println("Ores Workflows development server: http://127.0.0.1:8080");
  loop {
    val request = await server.accept();
    app.dispatch(request);
  }
  return;
}

define isoactor HtmxAsset as
  receive(ActorMail<String> mail): void {
    val request = http.claim(mail.value);
    request.set_header("X-Content-Type-Options", "nosniff");
    val string body = assets.htmx_js();
    await request.respond(200, "text/javascript; charset=utf-8", body);
    self.end();
    return;
  }
end

define isoactor CssAsset as
  receive(ActorMail<String> mail): void {
    val request = http.claim(mail.value);
    request.set_header("X-Content-Type-Options", "nosniff");
    val string body = assets.app_css();
    await request.respond(200, "text/css; charset=utf-8", body);
    self.end();
    return;
  }
end
